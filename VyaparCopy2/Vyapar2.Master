<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Vyapar2.master.cs" Inherits="VyaparCopy2.Vyapar2" %>

<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Pankhudi Beauty</title>
    <link href="Content/Global.css" rel="stylesheet" />
    <%--<link href="Content/Party%20and%20sale.css" rel="stylesheet" />--%>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="app-container">
            <!-- Window Header -->
            <div class="window-header">
                <div class="left-section">
                    <div class="logo">
                        <i class="fas fa-gem" style="color: #ff5722;"></i>
                    </div>
                    <span>Company</span>
                    <span>Help</span>
                    <span>Shortcuts</span>
                    <i class="fas fa-sync-alt"></i>
                </div>
                <div class="center-section">
                    <span>Customer Support : </span>
                    <i class="fas fa-phone-alt"></i>
                    <span>(+91)-6364444752</span>
                    <span class="divider">|</span>
                    <a href="#" class="support-link">Get Instant Online Support</a>
                </div>
                <div class="window-controls">
                    <button type="button" class="minimize"><i class="fas fa-minus"></i></button>
                    <button type="button" class="maximize"><i class="fas fa-square"></i></button>
                    <button type="button" class="close"><i class="fas fa-times"></i></button>
                </div>
            </div>

            <!-- Main Content -->
            <div class="main-content">
                <!-- Sidebar -->
                <div class="sidebar">
                    <div class="business-name">
                        <a href="EditProfile.aspx">
                            <div class="business-logo">
                                <img src="Content/images/logo.png" alt="Business Logo">
                            </div>
                            <div class="name-text">
                                <span class="business-title">Company Name</span>
                                <i class="fas fa-chevron-right"></i>
                            </div>
                        </a>
                    </div>

                    <ul class="nav-menu">
                        <li>
                            <a href="Home.aspx">
                                <i class="fas fa-home"></i>
                                <span>Home</span>
                            </a>
                        </li>
                        <li>
                            <a href="#" class="has-submenu">
                                <i class="fas fa-users"></i>
                                <span>Parties</span>
                                <i class="fas fa-chevron-down submenu-icon"></i>
                            </a>
                            <ul class="submenu">
                                <li>
                                    <a href="Party.aspx">
                                        <span>Party Details</span>
                                        <i class="fas fa-plus add-icon"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="PartyAdd.aspx">
                                        <span>Loyalty Points</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="ItemAdd.aspx">
                                        <span>Add Item</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="Items2.aspx">
                                <i class="fas fa-box"></i>
                                <span>Items</span>
                                <i class="fas fa-plus add-icon"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#" class="has-submenu">
                                <i class="fas fa-shopping-cart"></i>
                                <span>Sale</span>
                                <i class="fas fa-chevron-down submenu-icon"></i>
                            </a>
                            <ul class="submenu">
                                <li>
                                    <a href="SaleInvoice.aspx">
                                        <span>Sale Invoice</span>
                                        <i class="fas fa-plus add-icon"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="AddSale.aspx">
                                        <span>Estimate/Quatation</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="ItemAdd.aspx">
                                        <span>Payment In</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="Party.aspx">
                                        <span>Sale Order</span>
                                        <i class="fas fa-plus add-icon"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="DeliveryChallan.aspx">
                                        <span>Delivery Challan</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="ItemAdd.aspx">
                                        <span>Sale Return</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <li>
                            <a href="#" class="has-submenu">
                                <i class="fas fa-shopping-bag"></i>
                                <span>Purchase & Expense</span>
                                <i class="fas fa-chevron-down submenu-icon"></i>
                            </a>
                            <ul class="submenu">
                                <li>
                                    <a href="Purchases.aspx">
                                        <span>Purchases Invoice</span>
                                        <i class="fas fa-plus add-icon"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="AddSale.aspx">
                                        <span>Estimate/Quatation</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="ItemAdd.aspx">
                                        <span>Payment In</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="Party.aspx">
                                        <span>Sale Order</span>
                                        <i class="fas fa-plus add-icon"></i>
                                    </a>
                                </li>
                                <li>
                                    <a href="DeliveryChallan.aspx">
                                        <span>Delivery Challan</span>
                                    </a>
                                </li>
                                <li>
                                    <a href="ItemAdd.aspx">
                                        <span>Sale Return</span>
                                    </a>
                                </li>
                            </ul>
                        </li>
                        <%--<li>
                            <a href="#" class="has-submenu">
                                <i class="fas fa-chart-line"></i>
                                <span>Grow Your Business</span>
                                <i class="fas fa-chevron-down submenu-icon"></i>
                            </a>
                        </li>
                        <li>
                            <a href="#" class="has-submenu">
                                <i class="fas fa-university"></i>
                                <span>Cash & Bank</span>
                                <i class="fas fa-chevron-down submenu-icon"></i>
                            </a>
                        </li>
                        <li>
                            <a href="Reports.aspx">
                                <i class="fas fa-chart-bar"></i>
                                <span>Reports</span>
                            </a>
                        </li>
                        <li>
                            <a href="#">
                                <i class="fas fa-sync"></i>
                                <span>Sync, Share & Backups</span>
                                <i class="fas fa-check-circle" style="color: #4CAF50;"></i>
                            </a>
                        </li>
                        <li>
                            <a href="ApplyForLoan.aspx">
                                <i class="fas fa-hand-holding-usd"></i>
                                <span>Apply For Loan</span>
                            </a>
                        </li>
                        <li>
                            <a href="OtherProducts.aspx">
                                <i class="fas fa-cubes"></i>
                                <span>Other Products</span>
                            </a>
                        </li>
                        <li>
                            <a href="#" class="has-submenu">
                                <i class="fas fa-tools"></i>
                                <span>Utilities</span>
                                <i class="fas fa-chevron-down submenu-icon"></i>
                            </a>
                        </li>
                        <li>
                            <a href="Settings.aspx">
                                <i class="fas fa-cog"></i>
                                <span>Settings</span>
                            </a>
                        </li>
                        <li>
                            <a href="PlanInfo.aspx">
                                <i class="fas fa-info-circle"></i>
                                <span>Plan Info</span>
                            </a>
                        </li>--%>
                    </ul>
                </div>

                <!-- Content Area -->
                <div class="content-area">
                    <!-- Top Action Bar -->
                    <div class="action-bar">
                        <div class="search-container">
                            <i class="fas fa-search"></i>
                            <asp:TextBox ID="txtSearchTransactions" runat="server" placeholder="Search Transactions"></asp:TextBox>
                        </div>
                        <div class="action-buttons">
                            <asp:LinkButton ID="btnAddSale" runat="server" CssClass="btn-add-sale"><i class="fas fa-plus"></i> Add Sale</asp:LinkButton>
                            <asp:LinkButton ID="btnAddPurchase" runat="server" CssClass="btn-add-purchase"><i class="fas fa-plus"></i> Add Purchase</asp:LinkButton>
                            <asp:LinkButton ID="btnMore" runat="server" CssClass="btn-more"><i class="fas fa-plus"></i></asp:LinkButton>
                            <asp:LinkButton ID="btnPrint" runat="server" CssClass="btn-print"><i class="fas fa-print"></i></asp:LinkButton>
                            <asp:LinkButton ID="btnMenu" runat="server" CssClass="btn-menu"><i class="fas fa-ellipsis-v"></i></asp:LinkButton>
                        </div>
                    </div>

                    <!-- Content Placeholder -->
                    <asp:ContentPlaceHolder ID="MainContent" runat="server">
                    </asp:ContentPlaceHolder>
                </div>
            </div>
        </div>
    </form>
    <script src="Scripts/Global.js"></script>
     <asp:ContentPlaceHolder ID="Scripts" runat="server">
    </asp:ContentPlaceHolder>
</body>
</html>
